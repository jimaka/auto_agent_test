# Docker Compose 环境变量模板
# 复制为 .env 后修改: cp .env.example .env

# 远程访问凭据（生产环境务必修改）
VNC_PASSWORD=ship3dof
JUPYTER_TOKEN=ship3dof
SSH_PASSWORD=ship3dof

# 端口映射
NOVNC_PORT=6080
JUPYTER_PORT=8888
TENSORBOARD_PORT=6006
SSH_PORT=2222

# 桌面分辨率
VNC_RESOLUTION=1920x1080

# 是否启用 SSH
ENABLE_SSH=true

# Ingress 子路径模式（仅 K8s 需要，Docker 直连端口时保持默认）
# JUPYTER_BASE_URL=/jupyter
# TENSORBOARD_PATH_PREFIX=/tensorboard
