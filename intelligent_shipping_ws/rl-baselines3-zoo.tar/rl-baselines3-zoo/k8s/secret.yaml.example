# 凭据 Secret 模板 — 不要提交真实密码
# 用法:
#   cp k8s/secret.yaml.example k8s/secret.yaml
#   vim k8s/secret.yaml   # 填入真实密码
#   kubectl apply -f k8s/secret.yaml -n ship3dof
apiVersion: v1
kind: Secret
metadata:
  name: ship3dof-credentials
  namespace: ship3dof
  labels:
    app.kubernetes.io/name: ship3dof
type: Opaque
stringData:
  vnc-password: "CHANGE_ME_vnc"
  jupyter-token: "CHANGE_ME_jupyter"
  ssh-password: "CHANGE_ME_ssh"
